# ------------------------------------------------------------------
# Estúdio Gilvan — controle de acesso (lido APENAS no servidor)
# ------------------------------------------------------------------
# Nunca use o prefixo NEXT_PUBLIC_ nestas variáveis.
#
# Gere o hash da senha com:
#   npm run studio:hash-password -- "sua-senha-forte"
# e copie a linha gerada para STUDIO_PASSWORD_HASH.
STUDIO_PASSWORD_HASH=

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres aleatórios).
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
STUDIO_SESSION_SECRET=

# Duração da sessão do estúdio, em horas (padrão 12).
STUDIO_SESSION_HOURS=12

# ------------------------------------------------------------------
# Conteúdo
# ------------------------------------------------------------------
# "preview": mostra conteúdos pendentes de revisão clínica com selo visível.
# "production": o atlas público mostra apenas conteúdos com revisão aprovada.
NEXT_PUBLIC_CONTENT_MODE=preview

# URLs do ecossistema (opcional — há padrões em config/app.ts)
NEXT_PUBLIC_MOVIMENTOS_URL=
NEXT_PUBLIC_HISTORIAS_URL=
